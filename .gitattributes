assets/aravath/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/aravath/**/*.bin filter=lfs diff=lfs merge=lfs -text
assets/aravath/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/aravath/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/aravath/**/*.gltf text eol=lf
assets/aravath/**/*.tsv text eol=lf
assets/aravath/**/*.md text eol=lf
# Hashed text assets must stay LF on every OS. Windows autocrlf rewrites
# pine-forest glTF and the manifest check then fails.
*.gltf text eol=lf
*.glsl text eol=lf
*.obj text eol=lf
*.mtl text eol=lf
*.usda text eol=lf
*.hdr binary
*.ktx2 binary
